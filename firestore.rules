rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'team@backstage-beguna.app';
    }

    match /topics/{topicId} {
      // Die Themenliste darf von allen Personen mit dem Link gelesen werden.
      allow read: if true;

      // Nur der gemeinsame Backoffice-Nutzer darf Themen anlegen oder löschen.
      allow create, delete: if isAdmin();

      // Backoffice darf verwalten. Besucher dürfen ausschließlich ein freies
      // Thema einmalig mit einem Namen sichern. Freigeben ist nur im Backoffice möglich.
      allow update: if isAdmin() || (
        resource.data.status == 'frei'
        && request.resource.data.status == 'blockiert'
        && request.resource.data.claimedBy is string
        && request.resource.data.claimedBy.size() >= 2
        && request.resource.data.claimedBy.size() <= 60
        && request.resource.data.claimedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedAt'])
      );
    }

    // Kalender „Drehzeiten“: alle mit dem Link sehen die Einträge und dürfen
    // sich eintragen. Ändern und Löschen nur über das Backoffice.
    match /availability/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys()
          .hasOnly(['name', 'date', 'from', 'to', 'note', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.from is string
        && request.resource.data.from.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.to is string
        && request.resource.data.to.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.to > request.resource.data.from
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }
  }
}
